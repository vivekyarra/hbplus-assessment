{
  "expo": {
    "name": "HB+ Workspace",
    "slug": "hbplus-domain-access",
    "scheme": "fit.hbplus.workspace",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "fit.hbplus.workspace",
      "supportsTablet": true
    },
    "android": {
      "package": "fit.hbplus.workspace",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ]
  }
}
